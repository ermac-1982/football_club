APP_ENV=development
SECRET_KEY=replace-with-a-random-string-at-least-32-characters
APP_URL=http://localhost:8501

# Existing local database. The API creates its tables on startup.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=football_club

# Optional. When set, this replaces the POSTGRES_* fields above.
# DATABASE_URL=postgresql://postgres:your-postgres-password@localhost:5432/football_club

# Google Cloud OAuth client (Web application).
# Authorized redirect URI: http://127.0.0.1:8000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Football Club <noreply@localhost>
